VITE_API_TARGET=http://localhost:4000

# ===============================
# Security (Bước 6 - Bắt buộc production)
# ===============================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://staging.vnexplorer.vn,https://app.vnexplorer.vn
CSRF_SECRET=local_dev_csrf_secret_change_me_please_min_32_chars_ok_min_32_bytes_longer
TOTP_ISSUER=VietNam Explorer
NODE_ENV=development

# ===============================
# Database + Auth Core (cần copy sang .env production)
# ===============================
MONGODB_URI=mongodb://127.0.0.1:27017/vnexplorer
JWT_ACCESS_SECRET=replace_me_access_min_32_bytes_random_string_here_123
JWT_REFRESH_SECRET=replace_me_refresh_min_32_bytes_random_string_here_456
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===============================
# Bước 7 - Monitoring APM (Sentry + New Relic + Grafana Prometheus + Telegram DevOnCall)
# ===============================
# Sentry: Tạo project tương ứng Node.js (API) + React (Web) tại https://sentry.io/orgredirect
#  Để trống = disable hoàn toàn SDK trong cả môi trường dev/prod (no-op)
SENTRY_DSN_API=https://<yourPublicKey>@o<yourOrgId>.ingest.sentry.io/<yourProjectIdNode>
SENTRY_DSN_WEB=https://<yourPublicKey>@o<yourOrgId>.ingest.sentry.io/<yourProjectIdReact>
VITE_SENTRY_DSN_WEB=https://<yourPublicKey>@o<yourOrgId>.ingest.sentry.io/<yourProjectIdReact>
# Tracing sample rate bookings/P95: 0..1 (1 = ghi 100% transaction, production khuyến nghị 0.1-0.3 để tiết kiệm GB ingest)
SENTRY_TRACES_SAMPLE_RATE=0.3
VITE_SENTRY_TRACES_SAMPLE_RATE=0.3
# Session Replay sample on error (FE): 0..1 - production khuyến nghị 0.1
SENTRY_REPLAY_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_SAMPLE_RATE=0.1
# Environment tag cho Sentry grouping issue theo môi trường
SENTRY_ENVIRONMENT=development
VITE_SENTRY_ENVIRONMENT=development
# Release string theo format org@project@commit: giữ auto từ process env BUILD_VERSION hoặc string tĩnh
SENTRY_RELEASE=vnexplorer@0.1.0-local
VITE_SENTRY_RELEASE=vnexplorer@0.1.0-local

# New Relic APM (Node + Browser): để trống = disable NR agent (chỉ enable production nếu team DevOps quản lý)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=vnexplorer-api
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_LOG_LEVEL=info

# Grafana / Prometheus scrape: route GET /metrics (prom-client exposition format)
# Thêm ENV để Prometheus job target: disable route nếu = 0
ENABLE_METRICS_ENDPOINT=1
# Disable public /metrics auth, khuyến nghị enable trong VPC/Nginx allow IP Grafana scrape chỉ
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASS=

# Telegram DevOnCall Alert Bot (P95 booking > 200ms fire-and-forget, giữ trống để disable send)
#   Tạo bot: /newbot với @BotFather, lấy token dạng 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
#   Chat ID: group DevOnCall id hoặc cá nhân (gọi https://api.telegram.org/bot<token>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_DEVONCALL=
# Threshold P95 ms cho route group /api/bookings/** vượt quá → notify
APM_P95_BOOKING_THRESHOLD_MS=200
# Cooldown giây giữa 2 lần alert cùng pattern (tránh spam 1000 alert cùng 1 lỗi): mặc định 5 phút
APM_ALERT_COOLDOWN_SECONDS=300

# ===============================
# Bước 10 - Documentation Swagger/Scalar OpenAPI 3.1 + Postman QA
# ===============================
# Enable/disable toàn bộ UI swagger + scalar reference routes (1=enable, 0=disable)
SWAGGER_ENABLED=1
# Base URL OpenAPI servers hiển thị trên Scalar/Swagger UI (staging/production thay đổi giá trị)
SWAGGER_SERVER_URL=http://127.0.0.1:4000/api
SWAGGER_SERVER_DESC=Development localhost Nest 4000
SWAGGER_OG_IMG=https://vnexplorer.vn/og/swagger.png
# Basic Auth bảo vệ /api/swagger-ui + /api/reference trên staging/production (user:pass, bỏ trống = disable auth)
SWAGGER_UI_USER=
SWAGGER_UI_PASS=

PORT=4000
SERVER_ALLOW_PORT_BUMP=1

<script>
(function () {
    var input = document.getElementById('navSearchInput');
    if (!input) return;

    function filterProducts(keyword) {
        var kw = keyword.trim().toLowerCase();
        var cards = document.querySelectorAll('.product-grid .product-card:not(.empty-card)');
        var visibleCount = 0;

        cards.forEach(function (card) {
            var nameEl = card.querySelector('.product-name');
            var name = nameEl ? nameEl.textContent.toLowerCase() : '';
            var match = kw === '' || name.indexOf(kw) !== -1;
            card.style.display = match ? '' : 'none';
            if (match) visibleCount++;
        });

        // Nếu đang không ở trang chủ (không có product-grid), chuyển hướng khi Enter
        var grid = document.querySelector('.product-grid');
        if (!grid) {
            return false;
        }

        // Cuộn tới khu vực danh sách tour khi bắt đầu gõ
        if (kw !== '') {
            var menuSection = document.getElementById('menu');
            if (menuSection) {
                menuSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
        return true;
    }

    input.addEventListener('input', function () {
        filterProducts(input.value);
    });

    document.getElementById('navSearchForm').addEventListener('submit', function (e) {
        e.preventDefault();
        var grid = document.querySelector('.product-grid');
        if (!grid) {
            // Không ở trang chủ -> điều hướng về trang chủ kèm từ khóa
            window.location.href = '/home?search=' + encodeURIComponent(input.value.trim());
        } else {
            filterProducts(input.value);
        }
    });
})();
</script>
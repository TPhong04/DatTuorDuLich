{
  "name": "he-thong-tour-du-lich-server",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --dedupe --exit-child --project tsconfig.json --debounce 400 --notify false src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "seed": "ts-node --project tsconfig.json src/seed.ts",
    "killport": "powershell -NoProfile -Command \"$port=4000; $pids=@(netstat -ano 2>$null | Select-String -Pattern \\\":$port\\\\s+(LISTENING|TIME_WAIT)\\\" | ForEach-Object { ($_ -split '\\\\s+')[-1] } | Where-Object { $_ -match '^\\\\d+$' } | Select-Object -Unique); if ($pids.Count -gt 0) { Write-Host ('Killing PIDs on port '+$port+': '+($pids -join ', ')); $pids | ForEach-Object { try { taskkill /F /PID $_ /T 2>&1 | Out-Null } catch {} } } else { Write-Host ('No process listening on port '+$port) }\""
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/websockets": "^11.1.28",
    "@scalar/nestjs-api-reference": "^1.2.14",
    "@sentry/node": "^10.70.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "mongoose": "^8.16.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "totp.js": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cron": "^2.0.1",
    "@types/node": "^22.15.30",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}

// ============================================
// THÊM VÀO file prisma/schema.prisma hiện có
// ============================================

model ChatSession {
  id          String        @id @default(uuid())
  userId      String?       // null nếu khách chưa đăng nhập (guest)
  guestName   String?
  guestEmail  String?
  status      ChatStatus    @default(BOT)   // BOT | ESCALATED | CLOSED
  assignedTo  String?       // id của staff/admin xử lý khi escalated
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  messages    ChatMessage[]

  @@index([status])
  @@index([userId])
}

model ChatMessage {
  id          String      @id @default(uuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role        ChatRole    // USER | ASSISTANT | SYSTEM | STAFF
  content     String      @db.Text
  toolCalls   Json?       // lưu lại tool_calls nếu GPT gọi function
  toolResult  Json?       // kết quả trả về từ tool

  createdAt   DateTime    @default(now())

  @@index([sessionId])
}

enum ChatStatus {
  BOT
  ESCALATED
  CLOSED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
  STAFF
}
